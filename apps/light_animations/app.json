{
  "id": "light_animations",
  "title": "Light Animations",
  "description": "Lichthupe und benannte Frontleuchten für die Teststrecke. Standard ist die Simulation. Wagen schreibt die Fernlicht-Funktion des BDC und, nur im Stand und nur auf Zuruf, einen benannten FLM-Kanal.",
  "version": "0.1.1",
  "vendor": "custom",
  "loggingId": "OLA0",
  "iconGlyph": "LA",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": { "statusCarSpeed2": "rs" },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "ohne Fahrzeugzustand wird nichts ans Auto geschrieben",
      "VehicleCondition": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Light Animations",
      "buttons": [
        ["BTN_GO", "Lichthupe"],
        ["BTN_MUSTER", "Muster"],
        ["BTN_STOP", "Stopp"],
        ["BTN_PAGE", "Seite"],
        ["BTN_SETTINGS", "Einstellungen"]
      ]
    }
  ],
  "settings": [
    {"key": "light", "label": "Lichtsteuerung", "type": "choice", "default": "sim",
     "options": [["sim", "Simuliert"], ["wagen", "Wagen"]]},
    {"key": "gesture", "label": "Bedienung", "type": "choice", "default": "toggle",
     "options": [["toggle", "Start Stopp"], ["burst", "Stoß"], ["hold", "Halten"]]},
    {"key": "burst", "label": "Stoß", "type": "number", "default": 3, "steps": [1, 2, 3, 4, 6, 8]},
    {"key": "flash", "label": "Blitz", "type": "number", "unit": "ms", "default": 80, "steps": [50, 80, 100, 150]},
    {"key": "limit", "label": "Grenze", "type": "number", "unit": "s", "default": 30, "steps": [10, 20, 30]},
    {"key": "laser", "label": "Laser", "type": "bool", "default": true},
    {"key": "kurve", "label": "Kurvenlicht", "type": "bool", "default": false},
    {"key": "tag", "label": "Tagfahrlicht", "type": "bool", "default": false},
    {"key": "abblend", "label": "Abblendlicht", "type": "bool", "default": false},
    {"key": "anderes", "label": "Anderes", "type": "bool", "default": false}
  ]
}
